<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="tiny" android:textStyle="bold" />
    <com.gcl.gamechiefads.ui.NativeAdTemplateView
        android:id="@+id/n_tiny"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:gads_placement="native_main"
        app:gads_size="tiny" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="small" android:textStyle="bold" />
    <com.gcl.gamechiefads.ui.NativeAdTemplateView
        android:id="@+id/n_small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:gads_placement="native_main"
        app:gads_size="small" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="small_media" android:textStyle="bold" />
    <com.gcl.gamechiefads.ui.NativeAdTemplateView
        android:id="@+id/n_small_media"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:gads_placement="native_main"
        app:gads_size="small_media" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="medium" android:textStyle="bold" />
    <com.gcl.gamechiefads.ui.NativeAdTemplateView
        android:id="@+id/n_medium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:gads_placement="native_main"
        app:gads_size="medium" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="large" android:textStyle="bold" />
    <com.gcl.gamechiefads.ui.NativeAdTemplateView
        android:id="@+id/n_large"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:gads_placement="native_main"
        app:gads_size="large" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="full (fills its parent; fixed 420dp here)" android:textStyle="bold" />
    <com.gcl.gamechiefads.ui.NativeAdTemplateView
        android:id="@+id/n_full"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:layout_marginTop="4dp"
        app:gads_placement="native_main"
        app:gads_size="full" />
</LinearLayout>
