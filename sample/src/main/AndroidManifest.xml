<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".SampleApp"
        android:allowBackup="false"
        android:label="GamechiefAds Demo"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- Required by the Ads SDK and UMP. This is Google's TEST app id; use your own in real apps. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/admob_app_id" />

        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".MainActivity" />
        <activity android:name=".InterstitialActivity" />
        <activity android:name=".BannerActivity" />
        <activity android:name=".NativeActivity" />
        <activity android:name=".AppOpenActivity" />
        <activity android:name=".TraceActivity" />
        <activity android:name=".SecondActivity" />
    </application>
</manifest>
